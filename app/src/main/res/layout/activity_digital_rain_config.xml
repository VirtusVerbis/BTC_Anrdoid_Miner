<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dr_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_section_render_backend"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/dr_switch_opengl_backdrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/digital_rain_use_opengl_backdrop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/digital_rain_section_glyph_atlas"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/digital_rain_glyph_atlas_mode"
            android:textColor="?attr/colorOnSurface" />

        <Spinner
            android:id="@+id/dr_spinner_glyph_atlas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/digital_rain_glyph_atlas_labels"
            android:minHeight="48dp" />

        <!-- Motion -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/digital_rain_section_motion"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dr_label_matrix_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/digital_rain_matrix_frame_ms"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_matrix_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="4"
            android:value="100"
            android:valueFrom="16"
            android:valueTo="500"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/dr_label_line_len_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_line_len_min"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_line_len_min"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="3"
            android:valueFrom="1"
            android:valueTo="60"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/dr_label_line_len_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_line_len_max"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_line_len_max"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="20"
            android:valueFrom="1"
            android:valueTo="80"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/dr_label_speed_min"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_line_speed_min"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_speed_min"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="3"
            android:valueFrom="1"
            android:valueTo="50"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/dr_label_speed_max"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_line_speed_max"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_speed_max"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="15"
            android:valueFrom="1"
            android:valueTo="50"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/dr_label_column_mult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_column_y_multiplier"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_column_mult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="-20"
            android:valueFrom="-80"
            android:valueTo="0"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/dr_label_line_width"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_line_width"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_line_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="12"
            android:valueFrom="4"
            android:valueTo="48"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/dr_label_letter_height"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_letter_height"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_letter_height"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="14"
            android:valueFrom="6"
            android:valueTo="48"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/dr_label_font_scale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_font_scale"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_font_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="2"
            android:valueFrom="1"
            android:valueTo="8"
            app:labelBehavior="gone" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/dr_switch_big_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/digital_rain_use_big_text" />

        <!-- Depth -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/digital_rain_section_depth"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/dr_switch_depth_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/digital_rain_depth_enabled" />

        <TextView
            android:id="@+id/dr_label_depth_streak_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/digital_rain_depth_streak_count"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_depth_streak_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="3"
            android:valueFrom="1"
            android:valueTo="128"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/dr_label_depth_max_scale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_depth_max_scale_percent"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_depth_max_scale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="130"
            android:valueFrom="101"
            android:valueTo="600"
            app:labelBehavior="gone" />

        <!-- Colors -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/digital_rain_section_colors"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/digital_rain_head_rgb"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="R"
                tools:ignore="HardcodedText" />

            <com.google.android.material.slider.Slider
                android:id="@+id/dr_slider_head_r"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1"
                android:value="255"
                android:valueFrom="0"
                android:valueTo="255"
                app:labelBehavior="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="G"
                tools:ignore="HardcodedText" />

            <com.google.android.material.slider.Slider
                android:id="@+id/dr_slider_head_g"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1"
                android:value="255"
                android:valueFrom="0"
                android:valueTo="255"
                app:labelBehavior="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="B"
                tools:ignore="HardcodedText" />

            <com.google.android.material.slider.Slider
                android:id="@+id/dr_slider_head_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1"
                android:value="255"
                android:valueFrom="0"
                android:valueTo="255"
                app:labelBehavior="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/digital_rain_rain_rgb"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="R"
                tools:ignore="HardcodedText" />

            <com.google.android.material.slider.Slider
                android:id="@+id/dr_slider_rain_r"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="255"
                app:labelBehavior="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="G"
                tools:ignore="HardcodedText" />

            <com.google.android.material.slider.Slider
                android:id="@+id/dr_slider_rain_g"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1"
                android:value="255"
                android:valueFrom="0"
                android:valueTo="255"
                app:labelBehavior="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="B"
                tools:ignore="HardcodedText" />

            <com.google.android.material.slider.Slider
                android:id="@+id/dr_slider_rain_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="255"
                app:labelBehavior="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/digital_rain_background_rgb"
            android:textColor="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="R"
                tools:ignore="HardcodedText" />

            <com.google.android.material.slider.Slider
                android:id="@+id/dr_slider_bg_r"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="255"
                app:labelBehavior="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="G"
                tools:ignore="HardcodedText" />

            <com.google.android.material.slider.Slider
                android:id="@+id/dr_slider_bg_g"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="255"
                app:labelBehavior="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="B"
                tools:ignore="HardcodedText" />

            <com.google.android.material.slider.Slider
                android:id="@+id/dr_slider_bg_b"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:stepSize="1"
                android:value="0"
                android:valueFrom="0"
                android:valueTo="255"
                app:labelBehavior="gone" />
        </LinearLayout>

        <!-- Characters -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/digital_rain_section_character"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/dr_switch_alphabet_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_alphabet_only" />

        <TextView
            android:id="@+id/dr_label_ascii_range_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/digital_rain_ascii_range_1"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_ascii_1_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="33"
            android:valueFrom="32"
            android:valueTo="125"
            app:labelBehavior="gone" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_ascii_1_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="65"
            android:valueFrom="33"
            android:valueTo="127"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/dr_label_ascii_range_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_ascii_range_2"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_ascii_2_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="91"
            android:valueFrom="32"
            android:valueTo="125"
            app:labelBehavior="gone" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_ascii_2_end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="126"
            android:valueFrom="33"
            android:valueTo="127"
            app:labelBehavior="gone" />

        <!-- Key mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/digital_rain_section_key_mode"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/dr_switch_key_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_enable_key_mode" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/dr_switch_sticky_key_highlight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_sticky_key_highlights" />

        <TextView
            android:id="@+id/dr_label_key_reset_sec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/digital_rain_key_reset_sec"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_key_reset_sec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="60"
            android:valueFrom="1"
            android:valueTo="600"
            app:labelBehavior="gone" />

        <TextView
            android:id="@+id/dr_label_key_len"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_key_length_cols"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_key_length_cols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:value="0"
            android:valueFrom="0"
            android:valueTo="128"
            app:labelBehavior="gone" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/dr_switch_bitcoin_orange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/digital_rain_bitcoin_orange" />

        <!-- Reserved / anim -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/digital_rain_section_reserved"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/digital_rain_anim_mode"
            android:textColor="?attr/colorOnSurface" />

        <Spinner
            android:id="@+id/dr_spinner_anim_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/digital_rain_anim_labels"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/dr_label_text_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/digital_rain_text_frame_ms"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.slider.Slider
            android:id="@+id/dr_slider_text_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="10"
            android:value="400"
            android:valueFrom="50"
            android:valueTo="5000"
            app:labelBehavior="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dr_showcase_message_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/digital_rain_showcase_message">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dr_showcase_message_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dr_button_restore_defaults"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/digital_rain_restore_defaults" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dr_button_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/digital_rain_save"
                android:textColor="@color/black"
                app:backgroundTint="@color/bitcoin_orange" />
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
